extends CanvasLayer

func _ready():
    var screen_height = get_viewport().get_visible_rect().size.y
    var base_y = screen_height - 190

    create_button("LEFT", Vector2(30, base_y + 60), "ui_left")
    create_button("RIGHT", Vector2(150, base_y + 60), "ui_right")
    create_button("UP", Vector2(90, base_y), "ui_up")
    create_button("DOWN", Vector2(90, base_y + 120), "ui_down")

func create_button(label, pos, action):
    var button = Button.new()
    button.text = label
    button.position = pos
    button.size = Vector2(110, 90)
    add_child(button)

    button.button_down.connect(
        Input.action_press.bind(action)
    )
    button.button_up.connect(
        Input.action_release.bind(action)
    )
